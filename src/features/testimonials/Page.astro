---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingBand from '../../components/BookingBand.astro';
import Hero from '../../components/Hero.astro';
import { makeT } from '../../i18n/t';
import type { Lang } from '../../i18n/locales';
import reviews from '../../content/reviews.json';

const { lang } = Astro.props as { lang: Lang };
const t = makeT(lang);
---
<BaseLayout lang={lang} page="testimonials" title={t('meta.testimonials')}>
  <main>
    <Hero lang={lang} short eyebrow={t('stories.eyebrow')} title={t('stories.title')} lead={t('stories.lead')} />
    <section class="ui-section c-paper" id="reviews">
      <div class="ui-wrap ui-stack-lg">
        <h2 class="ui-h2">{t('stories.listTitle')}</h2>
        <p class="ui-body c-disclaimer">{t('stories.disclaimer')}</p>
        <div class="c-quotes">
          {reviews.map((r) => (
            <figure class="c-review">
              <blockquote class="c-quote" lang={r.lang}>{r.text.split('\n').map((para) => <p class="ui-body">{para}</p>)}</blockquote>
              <figcaption class="c-byline" lang="en">— {r.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
    <BookingBand lang={lang} />
  </main>
</BaseLayout>
<style>
  .c-quotes { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .c-review { margin: 0; padding: var(--space-4); background: var(--surface); border: var(--border-hairline) solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-soft); display: flex; flex-direction: column; gap: var(--space-2); }
  .c-quote { margin: 0; }
  .c-quote p + p { margin-top: var(--space-2); }
  .c-byline { font-weight: var(--w-label); }
</style>
