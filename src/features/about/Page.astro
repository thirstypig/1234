---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingBand from '../../components/BookingBand.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import { makeT } from '../../i18n/t';
import type { Lang } from '../../i18n/locales';
import { legacyImage, practicePhoto } from '../../lib/images';
import { isApproved } from '../../lib/claims';

const { lang } = Astro.props as { lang: Lang };
const t = makeT(lang);
const LANGS = ['english', 'mandarin', 'cantonese', 'taiwanese'];
/** Old-site claims (docs/copy-review.md), each shown once its id is approved. */
const claim = (id: string, key: string) => (isApproved(id) ? [t(`claims.${key}`)] : []);
const BIO = [
  t('about.bio1'),
  ...claim('F-about-12', 'clinic'),
  ...claim('F-about-13', 'focus'),
  ...claim('F-about-14', 'pilots'),
  t('about.bio2'),
  ...claim('F-about-9', 'experienced'),
  ...claim('F-about-10', 'patients'),
  ...claim('F-about-11', 'youngest'),
  t('about.bio3'),
  t('about.bio4'),
];
const CREDS = [...(isApproved('F-about-2') ? [t('doctor.years')] : []), ...claim('F-about-3', 'firstAsian'), ...claim('F-about-4', 'award')];
const CLINIC = [...claim('F-about-6', 'mission'), ...claim('F-about-7', 'equipment')];
const GALLERY = [
  [legacyImage('1234orthok-com-011.jpg'), 'frontDesk'],
  [legacyImage('1234orthok-com-017.jpg'), 'consult'],
  [legacyImage('1234orthok-com-030.jpg'), 'training'],
  [practicePhoto('staff-cake.jpg'), 'cake'],
  [legacyImage('1234orthok-com-065.jpg'), 'doctors'],
  [legacyImage('1234orthok-com-057.jpg'), 'huddle'],
  [practicePhoto('staff-flowers.jpg'), 'flowers', 'center 75%'],
  [legacyImage('1234orthok-com-012.jpg'), 'birthday'],
  [legacyImage('1234orthok-com-060.jpg'), 'car'],
  [legacyImage('1234orthok-com-073.jpg'), 'teamBanner', 'center 30%'],
] as const;
---
<BaseLayout lang={lang} page="about" title={t('meta.about')}>
  <main>
    <Hero lang={lang} short eyebrow={t('about.eyebrow')} title={t('about.title')} lead={t('about.lead')} />
    <section class="ui-section c-paper" id="doctor">
      <div class="ui-wrap">
        <div class="ui-doctor">
          <PhotoFrame image={legacyImage('1234orthok-com-003.jpg')} alt={t('doctor.photoAlt')} placeholder={t('doctor.photoAlt')} />
          <div class="ui-doctor-text ui-stack-lg">
            <h2 class="ui-h2">{t('about.bioTitle')}</h2>
            {CREDS.length > 0 && <ul class="c-creds" aria-label={t('claims.credentialsLabel')}>{CREDS.map((c) => <li>{c}</li>)}</ul>}
            {BIO.map((p) => <p class="ui-body">{p}</p>)}
            <p class="ui-lead">{t('doctor.languages')}</p>
            <ul class="ui-chips" aria-label={t('doctor.languagesLabel')}>
              {LANGS.map((l) => <li class="ui-chip"><Icon name="chat" />{t(`doctor.lang.${l}`)}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
    <section class="ui-section c-dawn" id="team">
      <div class="ui-wrap">
        <div class="ui-doctor">
          <PhotoFrame image={legacyImage('1234orthok-com-074.jpg')} alt={t('about.teamAlt')} placeholder={t('about.teamAlt')} />
          <div class="ui-doctor-text ui-stack-lg">
            <h2 class="ui-h2">{t('about.staffTitle')}</h2>
            {CLINIC.map((p) => <p class="ui-body">{p}</p>)}
            <p class="ui-lead">{t('about.staff')}</p>
          </div>
        </div>
        <ul class="c-gallery" aria-label={t('about.gallery.label')}>
          {GALLERY.map(([image, key, focus]) => (
            <li><figure><Image src={image} alt={t(`about.gallery.${key}`)} style={focus && `object-position: ${focus}`} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 290px" /><figcaption>{t(`about.gallery.${key}`)}</figcaption></figure></li>
          ))}
        </ul>
      </div>
    </section>
    <BookingBand lang={lang} />
  </main>
</BaseLayout>
<style>
  .c-creds { margin: 0; padding-left: 1.2em; display: grid; gap: var(--space-1); font-weight: var(--w-label); }
  .c-gallery { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-3); }
  .c-gallery figure { margin: 0; }
  .c-gallery figcaption { margin-top: var(--space-1); font-size: 15px; line-height: 1.5; }
  :global(:lang(zh)) .c-gallery figcaption { font-size: 17px; line-height: 1.7; }
  .c-gallery img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 25%; border-radius: calc(var(--radius-xl) - 12px); }
</style>
