---
import '../styles/site.css';
import { LOCALES, HTML_LANG, pathFor, type Lang, type PageId } from '../i18n/locales';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { REVIEW, SITE_ORIGIN } from '../lib/site-mode';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description?: string;
}
const { lang, page, title, description } = Astro.props;
const site = Astro.site?.origin ?? SITE_ORIGIN;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {REVIEW && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={site + pathFor(lang, page)} />
    {description && <meta name="description" content={description} />}
    {LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={site + pathFor(l, page)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Chiron+GoRound+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    {REVIEW && <script type="module" src="/_review/site-review.js" is:inline></script>}
    <Analytics />
  </head>
  <body>
    <div class="ui-page" lang={HTML_LANG[lang]}>
      <SiteHeader lang={lang} page={page} />
      <slot />
      <SiteFooter lang={lang} page={page} />
    </div>
  </body>
</html>
