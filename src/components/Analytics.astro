---
// Google Analytics 4 on the live site only: never in the review copy.
// Google signals and ad personalization are off, matching the privacy notice.
import { REVIEW, GA_ID } from '../lib/site-mode';
---
{!REVIEW && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} is:inline></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    </script>
  </>
)}
