---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm';
  block?: boolean;
  icon?: IconName;
  cta?: 'book' | 'message';
}
const { href, variant = 'primary', size, block, icon, cta } = Astro.props;
---
<a href={href} class:list={['ui-btn', `ui-btn--${variant}`, size && `ui-btn--${size}`, block && 'ui-btn--block']} data-cta={cta}>
  {icon && <Icon name={icon} />}<span><slot /></span>
</a>
