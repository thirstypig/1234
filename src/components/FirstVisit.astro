---
import type { ImageMetadata } from 'astro';
import PhotoFrame from './PhotoFrame.astro';
import type { Lang } from '../i18n/locales';
import { makeT } from '../i18n/t';

/** Defaults to the first-visit placeholder; How it works passes the practice's treatment steps instead. */
interface Props { lang: Lang; photo?: { image: ImageMetadata; alt: string }; title?: string; steps?: { title: string; body: string }[] }
const { photo, steps } = Astro.props;
const t = makeT(Astro.props.lang);
const title = Astro.props.title ?? t('home.visitTitle');
---
<section class="ui-section c-paper" id="visit">
  <div class="ui-wrap ui-grid">
    <div class="ui-span-5 ui-stack-lg"><h2 class="ui-h2">{title}</h2>{!steps && <p style="margin-top:var(--space-2)"><span class="ui-draft">{t('home.visitDraft')}</span></p>}{photo && <div class="c-visit-photo"><PhotoFrame image={photo.image} alt={photo.alt} placeholder={photo.alt} /></div>}</div>
    <ol class="ui-lines ui-at-7">
      {steps
        ? steps.map((s, i) => <li><span class="ui-n">{i + 1}</span><div><h3 class="ui-h3">{s.title}</h3><p class="ui-body">{s.body}</p></div></li>)
        : [1, 2, 3].map((n) => <li><span class="ui-n">{n}</span><p class="ui-body">{t(`home.visit${n}`)}</p></li>)}
    </ol>
  </div>
</section>
<style>
  .c-visit-photo :global(.ui-photo) { aspect-ratio: 4 / 3; }
</style>
