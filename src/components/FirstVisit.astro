---
import type { ImageMetadata } from 'astro';
import PhotoFrame from './PhotoFrame.astro';
import type { Lang } from '../i18n/locales';

/** The practice's numbered treatment steps (How it works). */
interface Props { lang: Lang; photo?: { image: ImageMetadata; alt: string }; title: string; steps: { title: string; body: string }[] }
const { photo, steps, title } = Astro.props;
---
<section class="ui-section c-paper" id="visit">
  <div class="ui-wrap ui-grid">
    <div class="ui-span-5 ui-stack-lg"><h2 class="ui-h2">{title}</h2>{photo && <div class="c-visit-photo"><PhotoFrame image={photo.image} alt={photo.alt} placeholder={photo.alt} /></div>}</div>
    <ol class="ui-lines ui-at-7 c-steps">
      {steps.map((s, i) => <li><span class="ui-n">{i + 1}</span><div><h3 class="ui-h3">{s.title}</h3><p class="ui-body">{s.body}</p></div></li>)}
    </ol>
  </div>
</section>
<style>
  /* The treatment steps take the numbered arrows from the practice's 2024 flyer (its #ec008c, darkened for AA contrast). */
  .c-steps .ui-n { width: 48px; border-radius: 0; background: #d6006f; color: #fff; padding-right: 8px; clip-path: polygon(0 0, 72% 0, 100% 50%, 72% 100%, 0 100%); }
  .c-visit-photo :global(.ui-photo) { aspect-ratio: 4 / 3; }
</style>
