export type IconName = keyof typeof PATHS;
interface Props { name: IconName }
const { name } = Astro.props;
---
<svg class="ui-ico c-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={PATHS[name]} />
